<?xml version="1.0" encoding="utf-8"?>
<!--
  Android blocks plain http:// by default (API 28+). The Laravel dev server
  isn't served over https, so this allows cleartext traffic only to the dev
  hosts this app talks to — not to the whole internet. For a LAN device,
  add its IP here too (and pass it via the dart-define flag for API_BASE_URL).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
